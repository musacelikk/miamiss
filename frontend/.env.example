# Kendi backend'imiz
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Canli site adresi (sitemap, canonical ve OG adresleri icin)
NEXT_PUBLIC_SITE_URL=https://www.miamisuhome.com

# --- BlogProduce (https://api.blogproduce.com) ---
# Gizli anahtar: dashboard > API Docs bolumunden uretilir.
# NEXT_PUBLIC_ oneki KULLANMAYIN — anahtar sadece sunucuda okunur.
# Tanimlanmazsa blog yalnizca yerel yazilarla calisir, build kirilmaz.
BLOGPRODUCE_API_KEY=bg_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BLOGPRODUCE_API_URL=https://api.blogproduce.com
# Blog sayfalarinin ISR tazeleme araligi (saniye, varsayilan 600)
BLOGPRODUCE_REVALIDATE=600
